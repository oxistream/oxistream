# Copy to .env and fill in the required values. Commented lines show the defaults.

# --- Compose ---

# Image to run; built from the repository when it does not exist locally.
# Published images: ghcr.io/OWNER/oxistream:X.Y.Z
#OXISTREAM_IMAGE=oxistream:local
# Host address and port. Use 8080 (all interfaces) to expose it without a reverse proxy.
#OXISTREAM_PUBLISH=127.0.0.1:8080

# Database password, also used for OXISTREAM_DATABASE_URL. Generate: openssl rand -hex 32
POSTGRES_PASSWORD=change-me

# --- Core ---

# HMAC key for proxy URLs and the OIDC login cookie, at least 32 characters.
# Generate: openssl rand -base64 48
OXISTREAM_PROXY_SECRET=change-me-to-at-least-32-random-characters
# Origin browsers use to reach this instance. Required for OIDC and when the reverse
# proxy rewrites Host; also used for links in Atom feeds.
#OXISTREAM_PUBLIC_URL=https://oxistream.example.com
#OXISTREAM_DATABASE_MAX_CONNECTIONS=10

# --- Auth ---

#OXISTREAM_AUTH_LOCAL_ENABLED=true
#OXISTREAM_REGISTRATION_ENABLED=true
# Anonymous users may search and watch unless this is true.
#OXISTREAM_REQUIRE_LOGIN=false
#OXISTREAM_SESSION_TTL_DAYS=30
# Browsers drop Secure cookies over plain HTTP (except on localhost). Set to false only
# for plain-HTTP testing.
#OXISTREAM_COOKIE_SECURE=true

# --- OIDC (enabled when issuer and client ID are set; needs OXISTREAM_PUBLIC_URL) ---

#OXISTREAM_OIDC_ISSUER=https://auth.example.com/realms/main
#OXISTREAM_OIDC_CLIENT_ID=oxistream
# Omit for public clients.
#OXISTREAM_OIDC_CLIENT_SECRET=
#OXISTREAM_OIDC_SCOPES=openid profile email
# Label of the sign-in button.
#OXISTREAM_OIDC_NAME=SSO
# Members of this group become admins; must match a claim value exactly.
#OXISTREAM_OIDC_ADMIN_GROUP=
# Dotted paths like realm_access.roles work.
#OXISTREAM_OIDC_GROUPS_CLAIM=groups

# --- Feed ---

#OXISTREAM_FEED_INTERVAL_MINUTES=30

# --- Proxy and rate limiting ---

#OXISTREAM_PROXY_STREAM_TTL_SECS=21600
#OXISTREAM_PROXY_IMAGE_TTL_SECS=604800
#OXISTREAM_RATE_LIMIT=true
#OXISTREAM_RATE_LIMIT_PER_SECOND=50
#OXISTREAM_RATE_LIMIT_BURST=200
# Header your reverse proxy sets to the client IP (last entry is used), e.g. X-Forwarded-For.
# Without it, all clients behind the proxy share one rate limit.
#OXISTREAM_TRUSTED_PROXY_HEADER=

# --- SponsorBlock ---

#OXISTREAM_SPONSORBLOCK_ENABLED=true
#OXISTREAM_SPONSORBLOCK_API_URL=https://sponsor.ajay.app

# --- History ---

# Longest retention users may pick: forever, 365d, 180d, 90d, 30d, 14d, 7d, 1d.
#OXISTREAM_HISTORY_MAX_RETENTION=forever

# --- Trending ---

# ISO country code for trending rows.
#OXISTREAM_TRENDING_REGION=US

# --- Logging ---

# tracing filter, e.g. info,oxistream_server=debug
#OXISTREAM_LOG=info
# pretty or json
#OXISTREAM_LOG_FORMAT=pretty
