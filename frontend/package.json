{
	"name": "oxistream-frontend",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"license": "AGPL-3.0-or-later",
	"packageManager": "pnpm@12.23.0",
	"engines": {
		"node": ">=24"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy localStorage preferredLanguage baseLocale --silent",
		"prepare": "pnpm i18n && svelte-kit sync || echo ''",
		"check": "pnpm i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "pnpm i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"test:storybook": "storybook build --quiet && playwright test -c playwright.storybook.config.ts",
		"gen:api": "openapi-typescript ../backend/openapi.json -o src/lib/api/schema.d.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@inlang/paraglide-js": "^3.2.2",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.81.0",
		"@playwright/test": "^1.65.1",
		"@storybook/addon-a11y": "^10.6.9",
		"@storybook/addon-docs": "^10.6.9",
		"@storybook/addon-svelte-csf": "^5.1.6",
		"@storybook/sveltekit": "^10.6.9",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.4.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@tailwindcss/vite": "^4.3.5",
		"@tanstack/svelte-query": "^6.4.7",
		"@types/node": "^26.6.6",
		"@videojs/dash-video": "10.7.0",
		"@videojs/html": "10.7.0",
		"bits-ui": "^2.22.0",
		"cn": "^0.5.2",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"mode-watcher": "^1.1.0",
		"openapi-fetch": "^0.17.0",
		"openapi-typescript": "^7.13.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn-svelte": "^1.8.2",
		"storybook": "^10.6.9",
		"svelte": "5.58.0",
		"svelte-check": "^4.7.8",
		"tailwind-variants": "^4.0.2",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.74.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.2"
	}
}
